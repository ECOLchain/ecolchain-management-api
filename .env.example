# Credenciais do OCI Object Storage (API S3-compativel) - Customer Secret Key
# gerada pelo Terraform (infra/terraform/management-api, outputs s3_access_key/s3_secret_key).
# Copie este arquivo para .env e preencha os valores reais. O arquivo .env esta no .gitignore.
# O Quarkus carrega .env automaticamente no startup (dev mode e producao).
QUARKUS_S3_AWS_CREDENTIALS_STATIC_PROVIDER_ACCESS_KEY_ID=
QUARKUS_S3_AWS_CREDENTIALS_STATIC_PROVIDER_SECRET_ACCESS_KEY=

# Credencial SMTP do OCI Email Delivery (modulo infra/terraform/oci/email-delivery,
# outputs smtp_username/smtp_password). Usada pelo quarkus-mailer - ver docs/email-delivery.md.
QUARKUS_MAILER_USERNAME=
QUARKUS_MAILER_PASSWORD=
